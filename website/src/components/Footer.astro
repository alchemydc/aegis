---
const sections = [
  {
    title: 'Product',
    links: [
      { href: '/features', label: 'Features' },
      { href: '/how-it-works', label: 'How It Works' },
      { href: '/download', label: 'Download' },
      { href: '/faq', label: 'FAQ' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { label: 'Blog' },
      { href: '/contact', label: 'Contact' },
      { label: 'Roadmap' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy-security', label: 'Privacy' },
      { label: 'Terms' },
      { label: 'Transparency' },
    ],
  },
];

const social = [
  { href: 'https://github.com/alchemydc/aegis', label: 'GitHub' },
  { label: 'X' },
  { label: 'Reddit' },
];

const withBase = (path) => (path.startsWith('/') ? `${import.meta.env.BASE_URL}${path.slice(1)}` : path);
---

<footer class="bg-charcoal text-off-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-3">
      {sections.map((section) => (
        <section>
          <h3 class="text-base font-semibold text-cyan">{section.title}</h3>
          <ul class="mt-4 space-y-2">
            {section.links.map((link) => (
              <li>
                {link.href ? (
                  <a href={withBase(link.href)} class="text-sm text-off-white/85 transition-colors hover:text-cyan">
                    {link.label}
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-2 text-sm text-off-white/40">
                    {link.label}
                    <span class="rounded-full border border-off-white/15 px-1.5 py-px font-mono text-[9px] uppercase tracking-widest text-off-white/45">
                      soon
                    </span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-border-light/10 pt-6 text-sm text-off-white/80 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; 2026 adblocked.ai. Open Source.</p>
      <div class="flex items-center gap-5">
        {social.map((item) =>
          item.href ? (
            <a href={item.href} class="transition-colors hover:text-cyan" rel="noopener">
              {item.label}
            </a>
          ) : (
            <span class="text-off-white/40">{item.label}</span>
          ),
        )}
      </div>
    </div>
  </div>
</footer>
