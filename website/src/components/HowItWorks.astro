---
import BeforeAfter from './BeforeAfter.astro';

const steps = [
  {
    title: 'Install the Extension',
    description: 'One click from the Chrome Web Store. adblocked.ai runs locally in your browser with zero configuration.',
  },
  {
    title: 'Use AI Normally',
    description: 'Open ChatGPT and chat as usual. The extension works silently in the background. More platforms coming.',
  },
];

const demoStep = {
  title: 'See the Difference',
  description: 'Ads and promoted content are stripped before they reach you. Your conversation is yours again. This is the first layer—more visibility is coming.',
};
---

<section id="how-it-works" class="bg-gray-50 py-20 dark:bg-charcoal/95" aria-labelledby="how-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h2 id="how-heading" class="text-center text-3xl font-bold text-navy dark:text-white">How It Works</h2>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {steps.map((step, idx) => (
        <article class="reveal rounded-xl border border-border-light bg-white p-6 dark:border-border-light/20 dark:bg-charcoal/50">
          <div class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-cyan font-semibold text-navy">
            {idx + 1}
          </div>
          <h3 class="mt-3 text-2xl font-semibold text-navy dark:text-white">{step.title}</h3>
          <p class="mt-3 text-base leading-7 text-gray-muted">{step.description}</p>
        </article>
      ))}
    </div>

    <article class="reveal mt-6 rounded-xl border border-border-light bg-white p-6 dark:border-border-light/20 dark:bg-charcoal/50">
      <div class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-cyan font-semibold text-navy">
        {steps.length + 1}
      </div>
      <h3 class="mt-3 text-2xl font-semibold text-navy dark:text-white">{demoStep.title}</h3>
      <p class="mt-3 text-base leading-7 text-gray-muted">{demoStep.description}</p>
      <BeforeAfter />
    </article>
  </div>
</section>
