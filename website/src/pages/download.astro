---
import Base from '../layouts/Base.astro';

const withBase = (path) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---

<Base title="Download adblocked.ai" description="Install adblocked.ai to block ads in AI conversations.">
  <section class="bg-charcoal py-20 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold">Install adblocked.ai</h1>
      <p class="mt-4 text-base text-off-white/80">
        Browser extension for ad-free AI conversations. Starting with ChatGPT.
      </p>
      <div class="mt-10 flex justify-center">
        <div
          role="img"
          aria-label="Coming soon to the Chrome Web Store"
          class="relative inline-flex items-center gap-4 overflow-hidden rounded-xl border border-dashed border-cyan/50 bg-white/[0.04] px-6 py-4 text-left shadow-[0_0_32px_rgba(0,217,255,0.12)]"
        >
          <span
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(0,217,255,0.16),transparent_70%)]"
          ></span>

          <span class="relative flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-cyan/30 bg-cyan/10 text-cyan">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              aria-hidden="true"
            >
              <rect x="2.5" y="3.5" width="19" height="17" rx="2.5" />
              <path d="M2.5 8.5h19" />
              <circle cx="5.9" cy="6" r="0.65" fill="currentColor" stroke="none" />
              <circle cx="8.2" cy="6" r="0.65" fill="currentColor" stroke="none" />
              <path d="M12 11.5v5.4" />
              <path d="m9.5 14.4 2.5 2.5 2.5-2.5" />
            </svg>
          </span>

          <span class="relative">
            <span class="block font-mono text-[11px] font-medium uppercase tracking-[0.22em] text-cyan">
              Coming soon to
            </span>
            <span class="mt-1 block text-xl font-semibold leading-tight text-white">Chrome Web Store</span>
          </span>
        </div>
      </div>

      <p class="mt-6 text-sm text-off-white/60">
        Not published yet.
        <a href={withBase('/contact')} class="font-medium text-cyan underline-offset-4 hover:underline">
          Get in touch
        </a>
        and we'll send the install link the day it ships.
      </p>
    </div>
  </section>

  <section class="bg-off-white py-16 dark:bg-charcoal">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-semibold text-navy dark:text-white">How to Install</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <article class="reveal rounded-xl border border-border-light bg-white p-5 dark:border-border-light/20 dark:bg-charcoal/50">
          <p class="text-sm font-semibold text-cyan">Step 1</p>
          <h3 class="mt-2 text-lg font-semibold text-navy dark:text-white">Open Store Listing</h3>
          <p class="mt-2 text-sm text-gray-muted">Visit the official extension listing.</p>
        </article>
        <article class="reveal rounded-xl border border-border-light bg-white p-5 dark:border-border-light/20 dark:bg-charcoal/50">
          <p class="text-sm font-semibold text-cyan">Step 2</p>
          <h3 class="mt-2 text-lg font-semibold text-navy dark:text-white">Add to Chrome</h3>
          <p class="mt-2 text-sm text-gray-muted">Click install and confirm permissions.</p>
        </article>
        <article class="reveal rounded-xl border border-border-light bg-white p-5 dark:border-border-light/20 dark:bg-charcoal/50">
          <p class="text-sm font-semibold text-cyan">Step 3</p>
          <h3 class="mt-2 text-lg font-semibold text-navy dark:text-white">Start Chatting</h3>
          <p class="mt-2 text-sm text-gray-muted">adblocked.ai begins protecting immediately.</p>
        </article>
      </div>
      <p class="mt-8 text-center text-sm text-gray-muted">
        Install the extension today. The control layer is coming.
      </p>
    </div>
  </section>
</Base>
