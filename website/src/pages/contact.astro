---
import Base from '../layouts/Base.astro';
---

<Base title="Contact adblocked.ai" description="Reach out to the adblocked.ai team with questions, feedback, or bug reports.">
  <section class="bg-off-white py-20 dark:bg-charcoal">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-navy dark:text-white">Contact</h1>
      <p class="mt-4 text-base text-gray-muted">
        Questions, feedback, or bug reports are welcome.
      </p>

      <div class="reveal mt-8 rounded-xl border border-border-light bg-white p-6 dark:border-border-light/20 dark:bg-charcoal/50">
        <p class="font-mono text-[11px] font-medium uppercase tracking-[0.22em] text-cyan">Email us</p>
        <a
          class="mt-2 inline-block text-2xl font-semibold text-navy underline decoration-cyan/70 underline-offset-4 hover:decoration-cyan dark:text-white"
          href="mailto:hello@adblocked.ai"
        >
          hello@adblocked.ai
        </a>
        <p class="mt-3 text-sm text-gray-muted">
          We read everything. Bug reports are especially welcome&mdash;include your browser version and the
          page you saw the problem on.
        </p>
      </div>
    </div>
  </section>
</Base>
