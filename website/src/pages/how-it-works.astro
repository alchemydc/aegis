---
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';

const steps = [
  {
    title: 'Install from the Chrome Web Store',
    detail:
      'Install adblocked.ai in one click. Once enabled, it immediately begins monitoring supported AI chat interfaces.',
  },
  {
    title: 'Open ChatGPT and Continue as Normal',
    detail:
      'No workflow changes. Chat exactly the same way while adblocked.ai runs silently in the background, watching for injected promotional content.',
  },
];

const demoStep = {
  title: 'Ads Removed. Clarity Restored.',
  detail:
    'When ad elements appear, adblocked.ai removes them in real-time. Your conversations stay clear and uninterrupted. This is the first layer—more visibility is coming.',
};
---

<Base title="How adblocked.ai Works" description="See how adblocked.ai blocks ads in AI conversations in three simple steps.">
  <section class="bg-gray-50 py-20 dark:bg-charcoal/95">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-navy dark:text-white">How It Works</h1>
      <p class="mt-4 max-w-2xl text-base text-gray-muted">
        Fast setup, invisible operation, immediate protection.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {steps.map((step, index) => (
          <article class="reveal rounded-xl border border-border-light bg-white p-6 dark:border-border-light/20 dark:bg-charcoal/50">
            <div class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-cyan font-semibold text-navy">
              {index + 1}
            </div>
            <h2 class="mt-3 text-2xl font-semibold text-navy dark:text-white">{step.title}</h2>
            <p class="mt-3 text-base leading-7 text-gray-muted">{step.detail}</p>
          </article>
        ))}
      </div>

      <article class="reveal mt-6 rounded-xl border border-border-light bg-white p-6 dark:border-border-light/20 dark:bg-charcoal/50">
        <div class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-cyan font-semibold text-navy">
          {steps.length + 1}
        </div>
        <h2 class="mt-3 text-2xl font-semibold text-navy dark:text-white">{demoStep.title}</h2>
        <p class="mt-3 text-base leading-7 text-gray-muted">{demoStep.detail}</p>
        <BeforeAfter />
      </article>
    </div>
  </section>
</Base>
